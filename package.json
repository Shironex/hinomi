{
  "name": "hinomi",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted monitor that joins deployments with vulnerability advisories.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @hinomi/server --filter @hinomi/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @hinomi/server start",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "brand": "node assets/brand/render.js",
    "showcase": "node scripts/showcase.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@noctcore/eslint-plugin-architecture": "^0.3.4",
    "@noctcore/eslint-plugin-async-safety": "^0.4.2",
    "@noctcore/eslint-plugin-code-quality": "^0.4.2",
    "@noctcore/eslint-plugin-contracts": "^0.7.2",
    "@noctcore/eslint-plugin-monorepo": "^0.2.4",
    "@noctcore/eslint-plugin-observability": "^0.3.4",
    "@noctcore/eslint-plugin-react": "^0.4.2",
    "@noctcore/eslint-plugin-security": "^0.4.2",
    "@noctcore/showcase-kit": "0.3.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
