# Hinomi boots with nothing set. Every value below is optional.
# Copy to .env to override; docker compose picks it up when present.

# Address and port the server listens on inside the container.
# If you change PORT, change the port mapping in docker-compose.yml too.
# HOST=0.0.0.0
# PORT=3000

# Folder for the SQLite database (hinomi.db). Defaults to /data in the
# container (the hinomi-data volume) and ./data in development.
# HINOMI_DATA_DIR=/data

# Secret used to encrypt source tokens (Coolify, GitHub) at rest. Without it
# Hinomi still runs, but sources cannot be connected. At least 16 characters;
# generate one with: openssl rand -base64 32
# Keep it stable: changing it makes stored tokens unreadable (enter them again).
# HINOMI_SECRET_KEY=

# Seconds a stop waits for a running scan before marking it interrupted.
# Whole number, 0 to 3600. Keep it below stop_grace_period in docker-compose.yml
# (30s), or below the Stop Grace Period of your platform (Coolify: Advanced).
# HINOMI_SHUTDOWN_TIMEOUT_SECONDS=25

# Access status (docs/access.md). Hinomi shows whether a request came through
# Tailscale or Cloudflare Access. Forwarded headers (X-Forwarded-For,
# CF-Connecting-IP, Tailscale-User-Login) are only believed from these proxies:
# comma separated IPs or CIDR ranges, for example the reverse proxy's network.
# HINOMI_TRUSTED_PROXIES=

# Verify the Cloudflare Access token. Set both or neither: the team name (or
# https://<team>.cloudflareaccess.com) and the application's AUD tag.
# HINOMI_CF_ACCESS_TEAM_DOMAIN=
# HINOMI_CF_ACCESS_AUD=

# Optional GitHub webhook: a second port that serves only the webhook path
# (POST /api/github/webhook). Point a tunnel or funnel at it, never at PORT.
# See docs/github-webhook.md.
# HINOMI_WEBHOOK_PORT=
