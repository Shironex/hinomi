# Hinomi boots with nothing set. Every value below is optional.
# Copy to .env to override; docker compose picks it up when present.

# Address and port the server listens on inside the container.
# If you change PORT, change the port mapping in docker-compose.yml too.
# HOST=0.0.0.0
# PORT=3000

# Folder for the SQLite database (hinomi.db). Defaults to /data in the
# container (the hinomi-data volume) and ./data in development.
# HINOMI_DATA_DIR=/data

# Secret used to encrypt source tokens (Coolify, GitHub) at rest. Without it
# Hinomi still runs, but sources cannot be connected. At least 16 characters;
# generate one with: openssl rand -base64 32
# Keep it stable: changing it makes stored tokens unreadable (enter them again).
# HINOMI_SECRET_KEY=
